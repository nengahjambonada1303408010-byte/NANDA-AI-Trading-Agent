<resources>
    <style name="Theme.NANDAAI" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_card</item>
        <item name="colorSurfaceVariant">@color/dark_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error colors -->
        <item name="colorError">@color/bearish</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>

        <!-- Default text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Action bar -->
        <item name="actionBarStyle">@style/NANDAActionBar</item>
    </style>

    <style name="NANDAActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/dark_card</item>
        <item name="titleTextStyle">@style/NANDAActionBarTitle</item>
    </style>

    <style name="NANDAActionBarTitle" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textColor">@color/accent_green</item>
    </style>
</resources>
